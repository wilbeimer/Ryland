# Copy to .env in the repository root. Never commit .env.

# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ANTHROPIC_API_KEY=

# Origin used in verification links. Default: http://localhost:5173
# APP_PUBLIC_URL=http://localhost:5173

# Leave SMTP_HOST unset to print verification links in the API console.
# Gmail: host smtp.gmail.com, port 587, and an app password (not the account password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
